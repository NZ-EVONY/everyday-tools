{
  "name": "everyday-tools",
  "version": "1.0.0",
  "private": true,
  "description": "Everyday Tools: a static site of free NZ calculators, date tools, printables and text tools, built into public/ and served as Cloudflare Workers static assets.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node scripts/build.mjs && node --test \"tests/unit/*.test.mjs\" \"tests/build/*.test.mjs\"",
    "regression": "node scripts/build.mjs && node --test \"tests/regression/*.test.mjs\"",
    "test:e2e": "node --test --test-concurrency=1 \"tests/e2e/*.test.mjs\"",
    "lighthouse": "node scripts/build.mjs && node scripts/lighthouse.mjs",
    "report:content": "node scripts/report-content.mjs",
    "report:claims": "node scripts/report-claims.mjs",
    "check:links": "node scripts/check-links.mjs",
    "serve": "node scripts/serve.mjs public 8788",
    "dev": "wrangler dev --local",
    "dry-run": "wrangler deploy --dry-run --outdir .wrangler-dry",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:deploy": "node scripts/check-deploy.mjs",
    "check:glyphs": "node scripts/build.mjs && node scripts/check-glyphs.mjs",
    "build:ads-preview": "node scripts/build.mjs --ads-preview",
    "measure:text": "node scripts/build.mjs && node scripts/measure-text.mjs"
  },
  "devDependencies": {
    "axe-core": "4.13.0",
    "lighthouse": "13.5.0",
    "playwright-core": "1.63.0",
    "wrangler": "4.145.0"
  }
}
